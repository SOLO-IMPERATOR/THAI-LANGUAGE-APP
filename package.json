{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:node": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "migrate:sqlite": "node scripts/migrate-to-sqlite.mjs",
    "seed:mysql": "php api/seed.php",
    "rebuild:words": "node scripts/rebuild-words-breakdown.mjs",
    "expand:phrases": "node scripts/expand-to-1500.mjs",
    "lint": "tsc --noEmit",
    "dev:api": "php -S 127.0.0.1:8080 -t . api/router-dev.php"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "dexie": "^4.4.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "lucide-vue-next": "^1.0.0",
    "motion": "^12.23.24",
    "node-edge-tts": "^1.2.10",
    "node-sqlite3-wasm": "^0.8.40",
    "pinia": "^4.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
